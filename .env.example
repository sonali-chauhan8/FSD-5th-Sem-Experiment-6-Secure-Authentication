# ========================================================
# Experiment 6: Secure User Authentication Environment Template
# ========================================================

# Backend Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection String (Local instance or MongoDB Atlas)
MONGO_URI=mongodb://127.0.0.1:27017/secure_auth_db

# JWT Secret Key (Use a strong, 256-bit or 32+ character random secret)
JWT_SECRET=your_jwt_secret_key_minimum_32_characters_here
JWT_EXPIRE=1h

# Frontend Client URL (For CORS & Cookie Whitelisting)
CLIENT_URL=http://localhost:5173
VITE_API_BASE_URL=http://localhost:5000/api
