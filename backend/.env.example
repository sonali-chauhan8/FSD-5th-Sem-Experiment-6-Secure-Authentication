# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (Local MongoDB or MongoDB Atlas connection string)
MONGO_URI=mongodb://127.0.0.1:27017/secure_auth_db
# For Atlas, use: mongodb+srv://<username>:<password>@cluster0.mongodb.net/secure_auth_db?retryWrites=true&w=majority

# JWT Authentication Configuration
JWT_SECRET=your_jwt_secret_key_minimum_32_characters_here
JWT_EXPIRE=1h

# Frontend Client URL for CORS and Cookie configuration
CLIENT_URL=http://localhost:5173
